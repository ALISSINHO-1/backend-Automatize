# PostgreSQL com psycopg2. Substitua todos os campos de exemplo.
DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO

# Gere uma chave local com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Este placeholder precisa ser substituído antes de iniciar a API.
JWT_SECRET_KEY=SUBSTITUA_POR_CHAVE_GERADA_LOCALMENTE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

STORAGE_BUCKET_NAME=evidencias-anexos
SUPABASE_URL=
SUPABASE_KEY=
# Seed manual de desenvolvimento; nunca execute com credenciais de produção.
DEMO_USER_NAME=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Tres contas permanentes DEMO. Configure as senhas somente no .env local.
DEMO_ADMIN_EMAIL=admin.demo@automatize.local
DEMO_ADMIN_PASSWORD=
DEMO_TECNICO_EMAIL=tecnico.demo@automatize.local
DEMO_TECNICO_PASSWORD=
DEMO_CLIENTE_EMAIL=cliente.demo@automatize.local
DEMO_CLIENTE_PASSWORD=
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

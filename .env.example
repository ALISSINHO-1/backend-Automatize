# PostgreSQL com psycopg2. Substitua todos os campos de exemplo.
DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO

# Gere uma chave local com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Este placeholder precisa ser substituído antes de iniciar a API.
JWT_SECRET_KEY=SUBSTITUA_POR_CHAVE_GERADA_LOCALMENTE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

STORAGE_BUCKET_NAME=evidencias-anexos
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
